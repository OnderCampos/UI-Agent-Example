# ===========================================
# Ecommerce Integration Template
# Environment Configuration
# ===========================================

# Application
NEXT_PUBLIC_APP_NAME="Ecommerce Store"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ===========================================
# Development Mode
# ===========================================
# Set to "true" to use mock data instead of real APIs
NEXT_PUBLIC_USE_MOCKS="true"

# ===========================================
# Commercetools Configuration
# ===========================================
# Project credentials from Commercetools Merchant Center
COMMERCETOOLS_PROJECT_KEY=""
COMMERCETOOLS_CLIENT_ID=""
COMMERCETOOLS_CLIENT_SECRET=""
COMMERCETOOLS_API_URL="https://api.us-central1.gcp.commercetools.com"
COMMERCETOOLS_AUTH_URL="https://auth.us-central1.gcp.commercetools.com"
COMMERCETOOLS_SCOPES="manage_project"

# ===========================================
# Contentful Configuration
# ===========================================
# Space and access credentials from Contentful
CONTENTFUL_SPACE_ID=""
CONTENTFUL_ACCESS_TOKEN=""
CONTENTFUL_PREVIEW_TOKEN=""
CONTENTFUL_ENVIRONMENT="master"
# Public token for client-side content fetching (if needed)
NEXT_PUBLIC_CONTENTFUL_SPACE_ID=""
NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=""

# ===========================================
# Algolia Configuration
# ===========================================
# Search credentials from Algolia dashboard
ALGOLIA_APP_ID=""
ALGOLIA_ADMIN_API_KEY=""
ALGOLIA_SEARCH_API_KEY=""
ALGOLIA_INDEX_NAME="products"
# Public keys for client-side search
NEXT_PUBLIC_ALGOLIA_APP_ID=""
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=""
NEXT_PUBLIC_ALGOLIA_INDEX_NAME="products"

# ===========================================
# External API - Digital Identity
# ===========================================
# Authentication and identity management API
DIGITAL_IDENTITY_API_URL=""
DIGITAL_IDENTITY_API_KEY=""

# ===========================================
# External API - Membership
# ===========================================
# Membership and loyalty program API
MEMBERSHIP_API_URL=""
MEMBERSHIP_API_KEY=""

# ===========================================
# External API - OMS Wrapper
# ===========================================
# Order Management System API
OMS_WRAPPER_API_URL=""
OMS_WRAPPER_API_KEY=""

# ===========================================
# External API - Delivery Windows
# ===========================================
# Delivery scheduling API
DELIVERY_WINDOWS_API_URL=""
DELIVERY_WINDOWS_API_KEY=""

# ===========================================
# External API - Tax
# ===========================================
# Tax calculation service
TAX_API_URL=""
TAX_API_KEY=""

# ===========================================
# External API - Payments
# ===========================================
# Payment processing service
PAYMENTS_API_URL=""
PAYMENTS_API_KEY=""
PAYMENTS_WEBHOOK_SECRET=""

# ===========================================
# Session & Security
# ===========================================
# Secret for signing cookies/tokens (generate a random 32+ char string)
AUTH_SECRET=""
# Session duration in seconds (default: 7 days)
SESSION_MAX_AGE="604800"

# ===========================================
# Caching Configuration
# ===========================================
# Product cache TTL in seconds (default: 5 minutes per backlog)
PRODUCT_CACHE_TTL="300"
# Content cache TTL in seconds (default: 1 hour)
CONTENT_CACHE_TTL="3600"

# ===========================================
# Feature Flags
# ===========================================
NEXT_PUBLIC_FEATURE_SEARCH_AUTOCOMPLETE="true"
NEXT_PUBLIC_FEATURE_PRODUCT_RECOMMENDATIONS="true"
NEXT_PUBLIC_FEATURE_QUICK_VIEW="true"
NEXT_PUBLIC_FEATURE_WISHLIST="true"
